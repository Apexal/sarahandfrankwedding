SECRET_KEY=xxx
DEBUG=True
# Leave DATABASE_URL unset locally to use SQLite; staging/production set it to Postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname
ALLOWED_HOSTS=127.0.0.1,localhost
ENV=development
LOG_LEVEL=INFO
# Staff/superusers must enroll MFA before using the app. Defaults to True when
# unset (staging/production); off locally so the seeded admin user can log in.
MFA_REQUIRED_FOR_STAFF=False
TZ=America/New_York
APP_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=someone@example.com
DEFAULT_REPLY_TO_EMAIL=
RESEND_API_KEY=xxx
POSTHOG_API_KEY=xxx
POSTHOG_DISABLED=False
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
BUCKET_NAME=xxx
# Both optional — the defaults already point at Tigris. `fly storage create`
# sets AWS_ENDPOINT_URL_S3 on the app automatically. Override only for a
# different S3-compatible provider (MinIO, real AWS, etc.).
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
